{
  "name": "nexus-backend",
  "version": "1.0.0",
  "description": "Backend Express pour 5 jeux mobiles AOF (Wax Sort, Ludo, Awalé, Savoir AOF, Frenezy Mbappé)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:routes": "bash scripts/test-all-routes.sh",
    "db:migrate": "echo 'Migration manuelle via Supabase SQL Editor — voir backend/migrations/'",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "5.0.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "rate-limit-redis": "4.2.0",
    "uuid": "10.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.16.11",
    "@types/uuid": "10.0.0",
    "jest": "29.7.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}